{
  "manifest_version": 3,
  "name": "Bedre Canvas",
  "version": "0.4.0",
  "description": "__MSG_description__",
  "default_locale": "nb",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "activeTab", "sidePanel"],
  "host_permissions": ["https://*.instructure.com/*", "https://canvas.ntnu.no/*", "https://canvas.bi.no/*"],
  "optional_host_permissions": ["https://*/*"],
  "icons": {
    "16": "icons/app/icon-16.png",
    "32": "icons/app/icon-32.png",
    "48": "icons/app/icon-48.png",
    "128": "icons/app/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Bedre Canvas",
    "default_icon": {
      "16": "icons/app/icon-16.png",
      "32": "icons/app/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.instructure.com/*", "https://canvas.ntnu.no/*", "https://canvas.bi.no/*"],
      "css": ["content/icons.css", "content/canvas.css", "content/canvas-ui.css", "content/pages.css", "content/dashboard.css"],
      "js": ["content/i18n.js", "content/content.js", "content/dashboard.js", "content/calendar.js", "content/trays.js", "content/layout.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
